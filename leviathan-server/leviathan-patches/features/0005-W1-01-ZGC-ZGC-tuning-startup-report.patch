+package dev.vospek.leviathan.jvm;
+
+import java.util.Locale;
+import org.apache.logging.log4j.Logger;
+
+/**
+ * W1-01 (patch 0005): ZGC 调优启动报告
+ * <p>
+ * 汇总本系列前四个 patch 的能力（参数检测、GC 指标、显式 GC 策略），
+ * 在启动时输出一次面向验收维度的摘要：
+ * GC Pause / Allocation Rate / Heap Usage / 显式 GC 策略。
+ * <p>
+ * MSPT / CPU / Startup 由既有 Observability 与启动计时覆盖，此处不重复采集。
+ */
+public final class ZgcTuningReport {
+
+    private final ZgcSupport support;
+    private final ZgcMetrics metrics;
+    private final SystemGcControl gcControl;
+
+    public ZgcTuningReport() {
+        this(new ZgcSupport(), new ZgcMetrics(), new SystemGcControl());
+    }
+
+    public ZgcTuningReport(ZgcSupport support, ZgcMetrics metrics, SystemGcControl gcControl) {
+        this.support = support;
+        this.metrics = metrics;
+        this.gcControl = gcControl;
+    }
+
+    /**
+     * 构造多行报告文本（每行一个验收维度）
+     */
+    public String buildReport() {
+        StringBuilder sb = new StringBuilder(512);
+        sb.append("gc=").append(support.currentGcName());
+        sb.append(" | zgcEnabled=").append(support.isZgcEnabled());
+        sb.append(" | collections=").append(metrics.totalCollectionCount());
+        sb.append(" | totalPauseMs=").append(metrics.totalCollectionTimeMs());
+        long heapAfterGc = metrics.heapUsedAfterGc();
+        sb.append(" | heapAfterGc=")
+            .append(heapAfterGc < 0 ? "n/a" : formatMb(heapAfterGc) + "MB");
+        sb.append(" | directMem=")
+            .append(metrics.directMemoryUsed() < 0
+                ? "n/a" : formatMb(metrics.directMemoryUsed()) + "MB");
+        double rate = metrics.allocationRateBytesPerSec();
+        sb.append(" | allocRate=")
+            .append(rate <= 0 ? "n/a(first-sample)"
+                : String.format(Locale.ROOT, "%.1fMB/s", rate / (1024.0 * 1024)));
+        String gcAdvice = gcControl.buildAdvice();
+        if (!gcAdvice.isEmpty()) {
+            sb.append(" | explicitGc: ").append(gcAdvice);
+        }
+        return sb.toString();
+    }
+
+    /**
+     * 启动时输出一次报告；ZGC 未启用时附带参数建议
+     */
+    public void logReport(Logger logger) {
+        logger.info("━━━ Leviathan ZGC Tuning Report ━━━");
+        logger.info("{}", buildReport());
+        String advice = support.buildAdvice();
+        if (!advice.isEmpty()) {
+            logger.info("Leviathan ZGC advice: {}", advice);
+        }
+    }
+
+    /**
+     * 供命令/诊断周期复用的组件访问器
+     */
+    public ZgcSupport support() {
+        return support;
+    }
+
+    public ZgcMetrics metrics() {
+        return metrics;
+    }
+
+    public SystemGcControl gcControl() {
+        return gcControl;
+    }
+
+    private static String formatMb(long bytes) {
+        return String.valueOf(bytes / (1024L * 1024));
+    }
+}
\ No newline at end of file
